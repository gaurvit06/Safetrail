# Copy to .env (repo root) and fill in. Never commit .env.
PUBLIC_URL=                    # https tunnel URL, used in QR codes
PRUNE_BASE_URL=https://api.withprune.com/v1
PRUNE_API_KEY=                 # ops key: daily spend cap set in Prune dashboard
PRUNE_PUBLIC_API_KEY=          # public (Break it) key: small cap, model allowlist = MODEL_SMALL only
PRUNE_MODEL_POLICY=balanced
PRUNE_CACHE_MODE=exact         # exact, or off to stop using Prune's cache. Never semantic (docs/DECISIONS.md, 28)
PRUNE_INJECTION_MODE=detect    # CONFIRM exact value in hour 1
MODEL_SMALL=                   # non-reasoning mini model configured in Prune's vault
MODEL_LARGE=                   # stronger model configured in Prune's vault
SMALL_OK_LANGS=en,hi
ADVISORY_LANGS=en,hi
USD_INR=88
MAX_CONCURRENT_AI_JOBS=3
MAX_CALLS_PER_MIN=60
PUBLIC_BUDGET_USD=0.50
PASS_SIGNING_KEY=              # optional base64 Ed25519 private key; if empty, one is generated in backend/keys/
LOG_SIGNING_KEY=               # optional base64 Ed25519 private key; if empty, one is generated in backend/keys/
TOKEN_SECRET=change-me         # any long random string (signs responder/presenter tokens)
RESPONDER_PIN=2468
PRESENTER_PIN=1357
SOS_SMS_NUMBER=                # demo number that receives SMS (leave blank to hide the SMS option)
SMS_WEBHOOK_SECRET=            # shared secret for POST /api/sms/inbound (empty = SMS webhook off)
APPROACH_M=80
CROWD_CELL_M=25
CROWD_TICK_S=10
CLUSTER_EPS_M=150
CLUSTER_SUMMARY_MIN_INTERVAL_S=60
QUIET_MIN_RISKY=15
QUIET_MIN=30
CHECK_NO_ANSWER_MIN=10
SMS_OFFER_AFTER_S=120
MAX_TREK_SPEED_KMH=30
PING_RETENTION_DAYS=7
DEMO_ZONE_RADIUS_M=75          # size of the "Landslide here" zone: covers the whole CSED block plus indoor GPS error
FRONTEND_ORIGIN=http://localhost:5173
# Planning-only prices (USD per 1M tokens) for the budget governor's estimates. Never shown as actual cost.
PRICE_SMALL_IN_PER_M=0.15
PRICE_SMALL_OUT_PER_M=0.60
PRICE_LARGE_IN_PER_M=2.50
PRICE_LARGE_OUT_PER_M=10.00
